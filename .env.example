# Server
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
FRONTEND_URL=https://your-frontend.vercel.app
# Public URL of THIS backend (used for email unsubscribe links). Render sets RENDER_EXTERNAL_URL automatically.
BACKEND_URL=https://drix-talenthub-backend.onrender.com

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Brevo email (never commit the real key)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@drixtechtalent.com
BREVO_SENDER_NAME=Drix Tech Talent
BREVO_DAILY_LIMIT=300

# AI assistant (server-side only)
GEMINI_API_KEY=

# Groq — free fallback for the AI assistant, used automatically only when every Gemini model
# above is out of quota or unreachable. No credit card required: console.groq.com/keys
GROQ_API_KEY=
# Optional — defaults to llama-3.3-70b-versatile if not set
GROQ_MODEL=

# Optional — raises GitHub's public API rate limit from 60/hr to 5,000/hr for capstone repo
# metadata fetches. Not required; submissions work fine without it. Free personal access token,
# no special scopes needed for public repos: github.com/settings/tokens
GITHUB_TOKEN=

# Optional
EXAM_MAX_ATTEMPTS=3

# Only for seed-admin.js
ADMIN_SEED_EMAIL=admin@drixtechtalent.com
ADMIN_SEED_PASSWORD=
